Package.resolved
gradle.lockfile
packages.lock.json
go.sum

# -----------------------------------------------------------------------------
# Temporary / logs / editor / OS noise
# -----------------------------------------------------------------------------
tmp/
temp/
logs/
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# Secrets / local credentials (Graphify also has safety screens; keep defense-in-depth)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
!.env.template
.secrets/
secrets/
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa
id_rsa.*

# -----------------------------------------------------------------------------
# Generated documentation/site output only — keep source docs/
# -----------------------------------------------------------------------------
_site/
docs/_build/
docs/build/
.docusaurus/
docs/.vitepress/cache/
docs/.vitepress/dist/
docs/.vuepress/.cache/
docs/.vuepress/dist/
storybook-static/

# -----------------------------------------------------------------------------
# Low-value administrative/release prose
# Keep README.md, ARCHITECTURE.md, ADRs, specs and normal docs/ by default.
# -----------------------------------------------------------------------------
CHANGELOG.md
CHANGELOG.*
HISTORY.md
HISTORY.*
RELEASE_NOTES.md
RELEASE_NOTES.*
CONTRIBUTING.md
CODE_OF_CONDUCT.md

# -----------------------------------------------------------------------------
# Project-local agent/bootstrap metadata retained from your previous file
# -----------------------------------------------------------------------------
skills-lock.json
Invoke-QwenTickets*.ps1
AGENTS.md
FIRST_RUN.md
PREREQUISITES.md
TEMPLATE_TEST_REPORT.md
TEMPLATE_VERSION.txt
docs/agents/IMPLEMENTATION_PROTOCOL.md
docs/agents/IMPLEMENT_ALL.md

# Intentionally NOT ignored by this universal baseline:
# README.md, ARCHITECTURE.md, docs/, specs/, ADRs, tests/, migrations/,
# Dockerfile/docker-compose files, package manifests, schemas and first-party configs.
# Also NOT ignored from your old file: Auftrag.md and SOURCES.md, because these may
# contain requirements, rationale or source provenance that is valuable to the graph.
