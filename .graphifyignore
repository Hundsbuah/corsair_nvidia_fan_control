# Universal .graphifyignore
# Goal: keep first-party source, tests, architecture/spec docs, schemas and useful configs;
# exclude dependencies, generated output, caches, agent/IDE metadata and low-value noise.
# Syntax: same as .gitignore.

# -----------------------------------------------------------------------------
# Version control / IDE / AI-agent metadata
# -----------------------------------------------------------------------------
.git/
.hg/
.svn/
# Remove the next line if CI/CD workflows belong in your architecture graph.
.github/
.vscode/
.idea/
.vs/
.fleet/
.zed/
.agents/
.qwen/
.pi/
.claude/
.codex/
.cursor/
.gemini/
.windsurf/
.continue/
.tools/
.tooling/
.tooling-state/
.worktrees/
.worktree/
.scratch/

# -----------------------------------------------------------------------------
# Graphify's own output / transient artifacts
# -----------------------------------------------------------------------------
graphify-out/
.graphify_semantic_parts/
.graphify_ast.json
.graphify_cached.json
.graphify_chunks.json
.graphify_detect.json
.graphify_extract.json
.graphify_analysis.json
.graphify_labels.json
.graphify_uncached.txt

# -----------------------------------------------------------------------------
# Third-party dependencies / virtual environments
# -----------------------------------------------------------------------------
node_modules/
vendor/
.venv/
venv/
.tox/
.nox/
__pypackages__/
site-packages/
.gradle/
.pnpm-store/
.npm/
.yarn/cache/
